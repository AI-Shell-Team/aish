#!/usr/bin/env expect
# Test: SSH remote git-aware prompt injection.
# Verifies that entering a bash remote session via ssh shows |branch,
# cd /tmp hides it, cd - restores it, and enable_remote_git_prompt=false
# disables the git part while preserving [ssh:host].

# Check for SSH loopback availability
if {![info exists env(AISH_SSH_LOOPBACK)] || $env(AISH_SSH_LOOPBACK) != 1} {
    unsupported "SSH loopback not available (set AISH_SSH_LOOPBACK=1 to enable)"
    return
}

# Determine aish binary path
set aish_bin "target/release/aish"
if {[info exists env(AISH_BIN)]} {
    set aish_bin $env(AISH_BIN)
}

# Determine aish startup arguments
set aish_args "run"
if {[info exists env(AISH_ARGS)]} {
    set aish_args $env(AISH_ARGS)
}

# Global error handlers for all expect blocks
expect_after {
    timeout { fail "Test timed out"; exit 1 }
    eof { fail "Unexpected EOF"; exit 1 }
}

# Test 1: ssh to localhost shows |branch when in a git repo.

# Create isolated config directory for initial test
set xdg_config [file join /tmp aish-test-[pid]]
file mkdir $xdg_config
file mkdir [file join $xdg_config aish]

# Save any prior XDG_CONFIG_HOME so we can restore it on exit — DejaGnu runs
# every .exp file in the same expect process, so leaking the override would
# point sibling tests at this throwaway directory.
set had_xdg_config_home [info exists env(XDG_CONFIG_HOME)]
if {$had_xdg_config_home} {
    set prev_xdg_config_home $env(XDG_CONFIG_HOME)
}

# Write initial config with git prompt enabled
set fh [open [file join $xdg_config aish config.yaml] w]
puts $fh "# Minimal aish config for testing"
puts $fh "model: test"
puts $fh "api_base: https://example.com"
puts $fh "api_key: test-key"
puts $fh "enable_remote_git_prompt: true"
close $fh

set env(XDG_CONFIG_HOME) $xdg_config

# Set working directory to the aish git repo (go up from tests/dejagnu to the repo root)
set cwd [file dirname [file dirname [file dirname [file normalize [info script]]]]]

# Spawn aish in the git repository
spawn $aish_bin $aish_args
set spawn_id $spawn_id

# Wait for aish to start - wait for prompt (might be $ or # or just empty line)
expect {
    -timeout 10
    -re {快速开始} { exp_continue }
    -re {[\$#] } { }
    -re {>_} { }
    -re {➜} { }
    -re {向 AI 提问} { exp_continue }
    -re {模型:} { exp_continue }
    timeout {
        # If timeout, it's ok - aish might be waiting at empty prompt
    }
}


# Change to the aish git repository before SSH
send "cd $cwd\r"
expect {
    -timeout 10
    -re {[\$#] } { }
    timeout {
        fail "cd command failed"; exit 1
    }
}


# Send ssh command
send "ssh localhost\r"
expect {
    -timeout 15
    -re {yes/no} {
        send "yes\r"
        exp_continue
    }
    -re {password} {
        fail "SSH password prompt not supported"; exit 1
    }
    timeout {
        fail "ssh did not connect"; exit 1
    }
}


# Look for the [ssh:...] marker AND the git branch indicator.
expect {
    -timeout 10
    -re {\[ssh:[^\]]+\].*\|main} {
        pass "git branch shown in remote prompt"
    }
    -re {\[ssh:[^\]]+\]} {
        fail "git marker not found in SSH prompt"
    }
    timeout {
        fail "git branch marker not found";
        exit 1
    }
}

# Test 2: cd /tmp hides the git marker.
send "cd /tmp\r"
expect {
    -timeout 3
    -re {\[ssh:[^\]]+\][^|]*[\$#] } {
        pass "git marker hidden outside repo"
    }
    -re {\|} {
        fail "git marker leaked in non-git directory"
    }
    timeout { fail "cd to non-git dir did not hide marker"; exit 1 }
}

# Test 3: cd back to a git repo shows marker again.
send "cd -\r"
expect {
    -timeout 3
    -re {\|main} {
        pass "git marker restored"
    }
    timeout {
        fail "git marker not restored after cd -";
        exit 1
    }
}

# Test 4: exit ssh.
send "exit\r"
expect {
    -timeout 3
    -re {[\$#] } {
        pass "ssh session exited"
    }
    timeout { fail "ssh did not exit cleanly"; exit 1 }
}

# Test 5: opt-out path — disable feature, re-enter, verify no git marker.

# Close current aish
send "exit\r"
expect {
    -timeout 3
    eof { }
    timeout { fail "aish did not exit cleanly"; exit 1 }
}

# Update config to disable git prompt
set fh [open [file join $xdg_config aish config.yaml] w]
puts $fh "# Minimal aish config for testing"
puts $fh "model: test"
puts $fh "api_base: https://example.com"
puts $fh "api_key: test-key"
puts $fh "enable_remote_git_prompt: false"
close $fh


# Spawn new aish with updated config
spawn $aish_bin $aish_args
set spawn_id $spawn_id

# Wait for initial prompt
expect {
    -timeout 10
    -re {[\$#] } { }
    -re {>_} { }
    -re {快速开始} { exp_continue }
    timeout { fail "aish did not start with opt-out config"; exit 1 }
}


# Send ssh command
send "ssh localhost\r"
expect {
    -timeout 5
    -re {yes/no} { send "yes\r"; exp_continue }
    -re {SSH_AUTH_SOCK|Last login|Creating directory} { exp_continue }
    -re {\[ssh:[^\]]+\]} { }
    -re {[\$#] } { }
    timeout { fail "opt-out: ssh did not connect"; exit 1 }
}


# Verify [ssh:host] marker is present
expect {
    -timeout 5
    -re {\[ssh:[^\]]+\]} { }
    timeout { fail "opt-out: ssh marker missing"; exit 1 }
}


# Verify NO |branch shows up (this is the critical opt-out check)
expect {
    -timeout 3
    -re {\|[\w]+} {
        fail "opt-out: git marker leaked despite flag=false";
        exit 1
    }
    -re {[\$#] } {
        pass "opt-out: no git marker with flag=false"
    }
    timeout {
        pass "opt-out: no git marker with flag=false"
    }
}

# Clean up
send "exit\r"
expect {
    -timeout 3
    eof { }
    timeout { fail "opt-out: aish did not exit cleanly"; exit 1 }
}

# Clean up temporary config
catch {file delete -force $xdg_config}
if {$had_xdg_config_home} {
    set env(XDG_CONFIG_HOME) $prev_xdg_config_home
} else {
    unset -nocomplain env(XDG_CONFIG_HOME)
}

# Exit successfully
exit 0
